#注意冒号后边都有个空格 别删别删
#任务列表 任务1&任务2
cbList: cg163&nga&mt_sign&hykb&quark&mcdonald&bigfun&aliyun&unicom
#是否需要推送结果 true全部推送  false以及不填只推送失败结果
needPush: true
#推送参数
Push:
#企业微信推送
  qywx:
    corpsecret:
    corpid:
    agentid:
    mediaid:
#telegram推送
  tgpushkey:
    tgbotoken:
    chatid:
#server酱turbo版
  sckey:
#qmsg酱
  qmsgkey:
#推送加
  pushplustoken:
#vocechat
  vocechat: 
    api: 
    uid: 
    key:

#网易云游戏网页端 请求头里
cg163:
  Authorization:

#nga论坛 app端
nga:
  uid:
  accesstoken:
  UA: xxxxxx Nga_Official/90306

#mt论坛 全部cookie
mt:
  cookie:
  time: ''

#好游快爆 scookie 去我的-赚爆米花-任务里 随便抓一个post包 请求数据里有scookie
#gid 和 key 分享需要兑换的商品链接查看
#例 https://huodong3.3839.com/n/hykb/bmhstore2/inc/libao/index.php?gid=6237
#gid就是6237 key就是libao
hykb:
  scookie:
  UA:
  qq:
  gid:
  key:

#夸克网盘 cookie
quark:
  cookie:

#麦当劳MCP token
mcdonald:
  token:

#BigFun(哔哩哔哩游戏社区) token在请求头里 x-csrf-token
bigfun:
  token:
  cookie:

#阿里云盘 refresh_token
aliyun:
  refresh_token:

#中国联通 token_online 抓包 https://m.client.10010.com/mobileService/onLine.htm 的请求体
unicom:
  token_online:
  phone:
  deviceId:
  appId: